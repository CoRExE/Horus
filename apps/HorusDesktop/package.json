{
  "name": "horus-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.cts && pnpm test:ui",
    "test:ui": "vitest run",
    "test:fixtures": "node tests/generate-media.mjs",
    "test:media": "pnpm test:fixtures && cargo test --manifest-path src-tauri/Cargo.toml --locked media_integration -- --ignored",
    "tauri": "tauri",
    "tauri:clean": "cd src-tauri && cargo clean && cd ..",
    "tauri:d": "tauri dev",
    "tauri:b": "tauri build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "build:rust": "cargo build --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@horus/core": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "axios": "^1.6.8",
    "fast-xml-parser": "^5.8.0",
    "hls.js": "^1.6.0",
    "lucide-react": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^25.5.2",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "26.1.0",
    "tsx": "4.23.11",
    "typescript": "~5.9.2",
    "vite": "^8.2.2",
    "vitest": "4.0.18"
  }
}
