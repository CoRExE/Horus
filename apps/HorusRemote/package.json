{
  "name": "horusremote",
  "version": "1.4.12",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:go": "HORUS_EXPO_GO=1 expo start --go",
    "android": "expo run:android",
    "android:clean": "node ../../scripts/release/clean-android.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:dev": "pnpm prebuild:android && expo run:android --variant debug",
    "build:preview": "node ../../scripts/release/build-android.mjs --preview",
    "prebuild:android": "node ../../scripts/release/prebuild-android.mjs",
    "build:prod:android": "node ../../scripts/release/build-android.mjs",
    "release": "release-it"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@horus/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-navigation-bar": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "fast-xml-parser": "^5.8.0",
    "lucide-react-native": "^1.8.0",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-cast": "^4.9.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-udp": "^4.1.7",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "release-it": "^20.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
