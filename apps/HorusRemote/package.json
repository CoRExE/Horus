{
  "name": "horusremote",
  "version": "1.4.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:dev": "pnpm prebuild:android && expo run:android --variant debug",
    "build:preview": "node ../../scripts/release/build-android.mjs --preview",
    "prebuild:android": "node ../../scripts/release/prebuild-android.mjs",
    "build:prod:android": "node ../../scripts/release/build-android.mjs",
    "release": "release-it"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@horus/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-navigation-bar": "~5.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "fast-xml-parser": "^5.8.0",
    "lucide-react-native": "^1.8.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-cast": "^4.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-udp": "^4.1.7",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "release-it": "^20.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
