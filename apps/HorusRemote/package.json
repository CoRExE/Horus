{
  "name": "horusremote",
  "version": "1.2.5",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:all": "eas build --profile production --platform all",
    "build:update": "eas update",
    "release": "release-it"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@horus/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "buffer": "^6.0.3",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-navigation-bar": "~5.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "fast-xml-parser": "^5.8.0",
    "lucide-react-native": "^1.8.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-cast": "^4.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "15.12.1",
    "react-native-udp": "^4.1.7",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@mwillbanks/release-it-expo-bumper-plugin": "^1.0.0",
    "@types/react": "~19.1.0",
    "release-it": "^20.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
